[Unit]
Description=Drool Detector & Router public dashboard (credential-free)
After=network.target

[Service]
Type=simple
User=drool-web
Group=drool-detector
WorkingDirectory=/opt/drool-detector/current
EnvironmentFile=/etc/drool-detector/drool-detector.env
# Required for the dashboard itself; the Sub2API key is loaded only by the worker.
Environment=DROOL_DATA_DIR=/var/lib/drool-detector
ExecStart=/usr/bin/python3 -m detector.server
Restart=on-failure
RestartSec=5
MemoryMax=160M
CPUQuota=30%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# The dashboard can read the public projection and write control files, nothing else.
InaccessiblePaths=/etc/drool-detector /var/lib/drool-detector/private
ReadWritePaths=/var/lib/drool-detector/controls
UMask=0027

[Install]
WantedBy=multi-user.target
