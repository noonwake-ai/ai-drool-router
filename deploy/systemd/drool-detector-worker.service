[Unit]
Description=Drool Detector & Router scheduled probes (Sub2API-backed)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=drool-worker
Group=drool-detector
WorkingDirectory=/opt/drool-detector/current
EnvironmentFile=/etc/drool-detector/drool-detector.env
# Whether the worker may write Sub2API is decided by config.json:
# routing.write_priority and routing.write_callable. Both default to false,
# so a stock deploy scores suppliers without touching your gateway.
ExecStart=/usr/bin/python3 -m detector.monitor --source timer
TimeoutStartSec=3300
MemoryMax=512M
CPUQuota=75%
TasksMax=48
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# The worker needs the private state database; the web unit never sees it.
ReadWritePaths=/var/lib/drool-detector
UMask=0027
