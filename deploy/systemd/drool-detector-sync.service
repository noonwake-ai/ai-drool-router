[Unit]
Description=AI Drool Router account metadata refresh (no model requests)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=drool-worker
Group=drool-detector
WorkingDirectory=/opt/drool-detector/current
EnvironmentFile=/etc/drool-detector/drool-detector.env
ExecStart=/usr/bin/python3 -m detector.monitor --source timer --metadata-only
TimeoutStartSec=600
MemoryMax=256M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/drool-detector
UMask=0027
