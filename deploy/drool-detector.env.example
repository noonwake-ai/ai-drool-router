# Copy to /etc/ai-drool-detector/drool-detector.env and chmod 600.
# Never commit the real file: it holds a Sub2API administrator key.
SUB2API_ADMIN_KEY=replace-with-your-sub2api-admin-key
DROOL_BASE_URL=https://your-sub2api-host
DROOL_DATA_DIR=/var/lib/ai-drool-detector
DROOL_CONFIG=/etc/ai-drool-detector/config.json
